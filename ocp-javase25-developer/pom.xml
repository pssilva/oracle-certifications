<?xml version="1.0" encoding="UTF-8"?><project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <artifactId>oracle-certificatons</artifactId>
    <groupId>br.com.oracle_certificatons.ocp</groupId>
    <version>1.0.0-SNAPSHOT</version>
  </parent>
  <groupId>br.com.oracle_certificatons.ocp.javase_25_developer</groupId>
  <artifactId>ocp-javase25-developer</artifactId>
  <packaging>pom</packaging>
  <name>ocp-javase25-developer</name>

  <properties>
    <maven.compiler.release>25</maven.compiler.release>
    <maven.compiler.source>25</maven.compiler.source>
    <maven.compiler.target>25</maven.compiler.target>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
  </properties>
  <modules>
    <module>01-building-blocks</module>
    <module>01-beyond-classes</module>
    <module>01-class-design</module>
    <module>02-making-decisions</module>
    <module>03-methods</module>
    <module>04-exceptions-localization</module>
    <module>05-collections-generics</module>
    <module>07-streams</module>
    <module>06-lambdas-functional-interfaces</module>
    <module>09-io-api</module>
    <module>11-modules</module>
    <module>11-modules/feeding</module>
    <module>11-modules/care</module>
    <module>11-modules/talks</module>
    <module>11-modules/staff</module>
    <module>11-modules/api</module>
    <module>11-modules/reservations</module>
    <module>11-modules/visitor</module>
    <module>12-packaging-deployment</module>
    <module>13-concurrency</module>
    <module>14-operators</module>
    <module>15-core-apis</module>
    <module>11-modules/agency</module>
    <module>11-modules/butterfly</module>
    <module>11-modules/caterpillar</module>
  </modules>
  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <executions>
          <!-- sobrescreve o release 21 herdado do POM raiz (compartilhado com o SE 17) -->
          <execution>
            <id>default-compile</id>
            <configuration>
              <release>25</release>
            </configuration>
          </execution>
          <execution>
            <id>default-testCompile</id>
            <configuration>
              <release>25</release>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
